# ──────────────────────────────────────────────────────────────────────────
# BOANERGES — Minimal environment config
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# `NEXT_PUBLIC_*` vars are exposed to the browser — keep secrets out of them.
# ──────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=artworks

# ── Paystack (NGN) ───────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx

# ── Admin notifications ─────────────────────────────────────────────────────
# Optional: keep email confirmations if you want them as well as WhatsApp.
RESEND_API_KEY=re_xxx
EMAIL_FROM="BOANERGES <orders@yourdomain.com>"
EMAIL_ADMIN_TO=admin@yourdomain.com

# WhatsApp admin alert via Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+2348000000000

# ── Admin bootstrap ────────────────────────────────────────────────────────
ADMIN_ALLOWLIST_EMAILS=admin@yourdomain.com

# ── Ambient sound (optional) ───────────────────────────────────────────────
NEXT_PUBLIC_AMBIENT_AUDIO_URL=
