# ──────────────────────────────────────────────────────────────────────────
# BOANERGES — Production storefront env
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Keep secrets server-only; only the public site URL is browser-exposed.
# ──────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payment provider ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx

# Manually maintained USD→NGN rate used to convert catalog (USD) prices to the
# NGN amount charged by Paystack. Update when the rate moves meaningfully.
USD_NGN_RATE=1600

# ── Seller notifications ────────────────────────────────────────────────────
# Customer confirmation email
RESEND_API_KEY=re_xxx
EMAIL_FROM="BOANERGES <orders@yourdomain.com>"

# Seller alert email
EMAIL_ADMIN_TO=admin@yourdomain.com

# Optional: enable WhatsApp alerts in addition to email
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+2348000000000

